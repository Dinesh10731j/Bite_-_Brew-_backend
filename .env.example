# =============================================================================
# Bite & Brew Backend — Environment Variables (safe placeholders)
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Node / Runtime ---------------------------------------------------------
NODE_ENV=production
PORT=7000

# Unique identifier for this API instance (e.g. "api-01").
# If omitted, a safe identifier is generated from POD_NAME/HOSTNAME/UUID.
INSTANCE_ID=

# Number of trusted proxy hops in front of this API (load balancer / reverse proxy).
# 1 = one trusted hop (recommended when behind a single LB). 0 = disable trust proxy.
TRUST_PROXY_HOPS=1

# Whether this replica should run BullMQ background workers (email, notifications).
# Set to "false" on API-only replicas.
ENABLE_WORKERS=true

# Graceful shutdown hard timeout (ms) before force-exiting the process.
SHUTDOWN_TIMEOUT_MS=30000

# --- Database (Neon PostgreSQL) ----------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Connection pool sizing. IMPORTANT: replicas x DB_POOL_MAX must stay under the
# database server's connection limit (e.g. Neon free tier = 10 concurrent).
DB_POOL_MAX=5
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_KEEP_ALIVE=true
DB_POOL_LOG_QUERIES=false

# --- Redis (Upstash) ----------------------------------------------------------
REDIS_URL=rediss://default:password@host:port

# --- Auth / JWT ---------------------------------------------------------------
# Use strong secrets (minimum 32 chars) in production.
JWT_SECRET_TOKEN=change-me
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowlist of origins. Credentials are used, so never use "*".
CORS_ORIGINS=https://biteandbrew.com,https://www.biteandbrew.com
FRONTEND_URL=https://biteandbrew.com

# --- Observability (OpenTelemetry) --------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=bite-brew-cafe-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# If auth headers are required, pass a JSON object:
# OTEL_EXPORTER_OTLP_HEADERS={"Authorization":"ApiKey xxx"}

# --- Email (SMTP) ---------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me

# --- Cloudinary (optional, for image uploads) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- reCAPTCHA (optional) --------------------------------------------------------
RECAPTCHA_SECRET_KEY=

# --- Security / Session -----------------------------------------------------------
SESSION_TTL_SECONDS=2592000
SINGLE_ACTIVE_SESSION=true
DEVICE_FINGERPRINT_ENFORCED=true
IP_ANOMALY_ENFORCED=false
EMAIL_VERIFICATION_REQUIRED=false
IDLE_SESSION_TIMEOUT_SECONDS=172800

# --- Account Protection -----------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_SECONDS=900

# --- Registration Anti-Abuse ------------------------------------------------------
MAX_REGISTRATIONS_PER_IP=5
MAX_REGISTRATIONS_PER_DEVICE=3
REGISTRATION_WINDOW_SECONDS=86400

# --- Rate Limiting -----------------------------------------------------------------
RATE_LIMIT_LOGIN_POINTS=10
RATE_LIMIT_LOGIN_DURATION=60
RATE_LIMIT_REGISTRATION_POINTS=5
RATE_LIMIT_REGISTRATION_DURATION=3600
RATE_LIMIT_REFRESH_POINTS=30
RATE_LIMIT_REFRESH_DURATION=60

# --- Security Auditing -------------------------------------------------------------
SECURITY_AUDIT_ENABLED=true

# --- Migrations ----------------------------------------------------------------------
# Set to "true" ONLY on a dedicated migration job. API replicas should keep "false".
RUN_MIGRATIONS=false
